# Jan Aawaz (जनAawaz) Backend Configuration Template
# Copy this file to .env and populate your deployment credentials.

# ── Application URLs ──────────────────────────────────────────────────────────
# Public frontend URL (used in tracking links sent to citizens and in dispatch letters)
PUBLIC_APP_URL=http://localhost:5173
# Public backend URL prefix used for absolute media URLs when using local storage
PUBLIC_API_URL=http://localhost:8000

# ── Gemini Multimodal AI ──────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.5-flash

# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite default:
# DATABASE_URL=sqlite+aiosqlite:///./fordge.db
# Production Supabase PostgreSQL:
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ── Supabase Cloud Storage (Optional - falls back to local UPLOAD_DIR) ────────
SUPABASE_URL=https://[YOUR-PROJECT-ID].supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key
SUPABASE_BUCKET=reports
UPLOAD_DIR=./uploads

# ── Authentication & Security ─────────────────────────────────────────────────
# Secret key used to sign PyJWT tokens (MUST be at least 32 characters; required at startup unless DEV_MODE=true).
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate_with_python_secrets_token_urlsafe_48_min_32_chars

# Comma-separated list of authority emails (eligible for administrative triage & closeout actions).
AUTHORITY_EMAILS=officer@example.com,engineer@example.com,admin@example.com

# Comma-separated allowed CORS origins (no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# Dev mode toggle: when true, allows per-process ephemeral JWT secret and returns dev_code in OTP responses
DEV_MODE=false

# ── Email Service & Dispatch Agent ───────────────────────────────────────────
# Email provider: "smtp" (default), "resend", or "brevo"
EMAIL_PROVIDER=smtp

# Dispatch operation mode: "demo" (default) or "live"
# In demo mode, emails are sent only to DISPATCH_EMAIL and subject is prefixed with [DEMO].
# In live mode, emails are dispatched to the resolved municipal department and CCed to TEAM_CC_EMAILS.
DISPATCH_MODE=demo

# Fallback dispatch inbox where unmapped issues (or all demo issues) are routed
DISPATCH_EMAIL=dispatch@example.com

# Comma-separated team CC emails included on live municipal dispatches
TEAM_CC_EMAILS=team@example.com,alerts@example.com

# Reply-To address where municipal and citizen replies will reach the team
REPLY_TO=team@example.com

# For EMAIL_PROVIDER=brevo (via Brevo REST API - 300 free emails/day to ANY address without custom domain):
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here
# BREVO_SENDER_EMAIL=portal@example.com
# BREVO_SENDER_NAME=Jan Aawaz Portal

# For EMAIL_PROVIDER=smtp:
GMAIL_USER=your_email@example.com
GMAIL_APP_PASSWORD=your_16_character_gmail_app_password
EMAIL_FROM=Jan Aawaz (जनAawaz) Portal <portal@example.com>

# For EMAIL_PROVIDER=resend (via Resend REST API):
RESEND_API_KEY=re_your_resend_api_key_here

# ── SLA Watchdog Background Agent ─────────────────────────────────────────────
# Polling interval in seconds (default 60)
WATCHDOG_INTERVAL_SEC=60
# Time compression scale factor for hackathon live demos (e.g. 1 = normal real-time, 60 = 1 minute per hour)
SLA_TIME_SCALE=1
