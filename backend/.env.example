# Google Gemini Multimodal AI Key
GEMINI_API_KEY=your_gemini_api_key_here

# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite (Default for localhost):
DATABASE_URL=sqlite+aiosqlite:///./fordge.db

# Supabase PostgreSQL (for cloud deployment):
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── Cloud Media Storage (Optional for Supabase on Vercel) ────────────────────
# SUPABASE_URL=https://[PROJECT-REF].supabase.co
# SUPABASE_KEY=your_supabase_anon_or_service_key
# SUPABASE_BUCKET=reports

# ── Citizen Email Verification ────────────────────────────────────────────────
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_app_password
# EMAIL_FROM=CivicLine Public Grievance Portal <your_email@gmail.com>
